# Copy this file to .env and fill in values before running docker-compose or the backend locally.

# Create a project at supabase.com, then run backend/schema.sql once in its SQL Editor to
# create the tables (there's no migration tool in this project -- see backend/schema.sql).
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role secret. NOT the anon/publishable key -- the backend
# does its own per-user authorization in application code rather than relying on Postgres
# Row-Level Security, so it needs unrestricted server-side access. Never expose this key to
# the frontend or commit it.
SUPABASE_SERVICE_KEY=

# Used to sign JWT access tokens. Use a long random string in any real deployment.
JWT_SECRET=change-me-in-production

# Optional but required for the AI features: photo nutrition extraction, the chat assistant,
# and the LLM fallback for PDF import. Without it, those endpoints return a clear 503 error
# and the rest of the app works normally.
#
# Uses the OpenAI SDK against an OpenAI-compatible endpoint. Configured here for OpenRouter
# (https://openrouter.ai) rather than OpenAI directly -- get a key at openrouter.ai/keys.
# To use OpenAI directly instead: unset OPENAI_BASE_URL and set OPENAI_MODEL to a plain
# OpenAI model id (e.g. gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Frontend: shows/hides the chat assistant and the photo-scan control. Defaults to false here
# since it needs a funded OPENAI_API_KEY to actually work -- flip to true once you have credits.
VITE_ENABLE_AI_FEATURES=false
